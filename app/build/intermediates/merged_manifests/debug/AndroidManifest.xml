<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartdental.care"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <permission
        android:name="com.smartdental.care.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.smartdental.care.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.smartdental.care.SmartDentalApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.SmartDentalCare"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.smartdental.care.ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartDentalCare" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.smartdental.care.ui.onboarding.OnboardingActivity" />
        <activity android:name="com.smartdental.care.ui.onboarding.ConsentActivity" />
        <activity
            android:name="com.smartdental.care.ui.login.DoctorLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.smartdental.care.ui.login.SignUpActivity" />
        <activity android:name="com.smartdental.care.ui.login.ForgotPasswordActivity" />
        <activity android:name="com.smartdental.care.ui.login.EmailOtpActivity" />
        <activity android:name="com.smartdental.care.ui.login.VerifyOtpActivity" />
        <activity android:name="com.smartdental.care.ui.login.ResetPasswordActivity" />

        <!--
          AuthCallbackActivity intercepts the magic link when the user taps
          the "Sign In" button in their email.
          URL scheme: smartdental://auth/callback
        -->
        <activity
            android:name="com.smartdental.care.ui.login.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask" >

            <!-- OTP / Magic Link login -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="auth"
                    android:pathPrefix="/callback"
                    android:scheme="smartdental" />
            </intent-filter>

            <!-- Password Reset link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="auth"
                    android:pathPrefix="/reset"
                    android:scheme="smartdental" />
            </intent-filter>
        </activity>
        <activity android:name="com.smartdental.care.ui.dashboard.DoctorDashboardActivity" />
        <activity android:name="com.smartdental.care.ui.dashboard.PatientRecordsActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.AppointmentsActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.PatientDetailActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.RegistrationActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.SignatureActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.ChartingActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.DoctorSpeechToTextActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.StlScanActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.DentalPhotoComparisonActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.BillingActivity" />
        <activity android:name="com.smartdental.care.ui.dashboard.DoctorProfileActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.PrescriptionActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.PaymentSuccessActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.PatientNotesActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.OnlineConsultationActivity" />
        <activity android:name="com.smartdental.care.ui.appointments.PatientReportsActivity" />

        <!-- Reminder alarm receiver -->
        <receiver
            android:name="com.smartdental.care.util.ReminderReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.smartdental.care.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="io.github.jan.supabase.storage.SupabaseInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="io.github.jan.supabase.gotrue.SupabaseInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="com.russhwolf.settings.SettingsInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>