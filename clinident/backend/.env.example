# ══════════════════════════════════════════════════════════════
#  CLINIDENT BACKEND — Environment Variables
#  Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# JWT (keep for session tokens — used alongside Firebase Auth)
JWT_SECRET=clinident_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (CORS — add all origins that should be allowed)
# Use * to allow all (recommended during Android development)
FRONTEND_URL=*

# ── Firebase Admin SDK (from Firebase Console → Project Settings → Service Accounts)
# Go to: Firebase Console → Your Project → ⚙️ Settings → Service accounts → Generate new private key
# Download the JSON file, then copy the values below:

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=000000000000000000000
FIREBASE_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com

# Firebase Storage bucket (find in Firebase Console → Storage → your bucket URL)
# Format: your-project-id.firebasestorage.app  OR  your-project-id.appspot.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ── Android app network access ──────────────────────────────────────────────
# When running backend on your PC and testing on Android device (same WiFi):
#   1. Run `ipconfig` in terminal to find your PC's local IP (e.g. 192.168.1.105)
#   2. Set HOST=0.0.0.0 so server binds to all interfaces
#   3. In your Android app, use http://192.168.1.105:5000 as the base URL
HOST=0.0.0.0
